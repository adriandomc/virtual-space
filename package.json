{
  "name": "virtual-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx src/server.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/server.js",
    "maintenance": "node server-dist/maintenance.js",
    "operations": "node server-dist/operations.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.7",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
