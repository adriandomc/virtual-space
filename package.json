{
  "name": "virtual-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-three.mjs && node scripts/copy-texture-transcoder.mjs",
    "assets:encode": "node scripts/encode-materials.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx src/server/server.ts",
    "check": "node scripts/check-architecture.mjs && tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json",
    "build": "npm run check && vite build && node scripts/build-static-assets.mjs && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/server/server.js",
    "maintenance": "node server-dist/server/maintenance.js",
    "operations": "node server-dist/server/operations.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:e2e": "npm run build:e2e && playwright test --project=chromium",
    "test:e2e:webkit": "npm run build:e2e && playwright test --project=webkit",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0",
    "i18next": "^26.4.7",
    "lucide-react": "^0.468.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.20",
    "three": "0.180.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.7",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "6.2.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
